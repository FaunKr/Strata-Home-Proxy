# Adresse, auf der der Proxy lauscht. Clients zeigen künftig hierhin.
LISTEN_ADDR=0.0.0.0:8080

# Strata auf dem PC (feste IP aus dem Router, Port aus START-HERE.bat)
STRATA_URL=http://192.168.1.50:8080

# API-Key von Strata (--api-key beim Setup). Der Proxy setzt ihn bei jeder
# Anfrage an Strata ein; Clients bekommen eigene Keys auf der Seite API-Keys.
#STRATA_API_KEY=

# MAC-Adresse der Netzwerkkarte des PCs (Format AA:BB:.. oder AA-BB-..).
# Nur für den allerersten Start nötig: sobald der PC-Dienst läuft, meldet er
# seine MAC selbst, und die gilt dann.
PC_MAC=AA-BB-CC-DD-EE-FF

# Broadcast-Adresse des Heimnetzes, Port 9
WOL_ADDR=192.168.1.255:9

# Dienst auf dem PC (kommt in Schritt 3). Ohne ihn: kein Gaming-Modus,
# kein automatisches Schlafen, nur Wecken.
#PC_AGENT_URL=http://192.168.1.50:8091
#PC_AGENT_TOKEN=langes-zufaelliges-geheimnis

# Wartezeit bis zum Schlafen in Sekunden (15 min)
IDLE_TIMEOUT_SECS=900

# Längste Wartezeit beim Aufwachen in Sekunden (inkl. Strata-Neustart)
WAKE_TIMEOUT_SECS=240

# Startpasswort der Weboberfläche unter /admin/ (sonst "admin"). Beim ersten
# Login muss ein eigenes Passwort festgelegt werden.
#UI_PASSWORD=
