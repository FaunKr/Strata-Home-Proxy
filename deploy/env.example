# Address the proxy listens on. Clients point here from now on.
LISTEN_ADDR=0.0.0.0:8080

# Strata on the PC (fixed IP from the router, port from START-HERE.bat)
STRATA_URL=http://192.168.1.50:8080

# Strata's API key (--api-key at setup). The proxy adds it to every
# request to Strata; clients get keys of their own in the web UI's Access area.
#STRATA_API_KEY=

# MAC address of the PC's network card (format AA:BB:.. or AA-BB-..).
# Only needed for the very first start: as soon as the PC service runs, it
# reports its MAC itself, and that one applies from then on.
PC_MAC=AA-BB-CC-DD-EE-FF

# Broadcast address of the home network, port 9
WOL_ADDR=192.168.1.255:9

# PC service (comes in step 3). Without it: no gaming mode,
# no automatic sleep, only waking.
#PC_AGENT_URL=http://192.168.1.50:8091
#PC_AGENT_TOKEN=long-random-secret

# Runner of the code benchmark (service code-bench). docker-compose.yml already
# sets it; without it only the code benchmark is missing.
#CODE_BENCH_URL=http://127.0.0.1:8096

# Limits in seconds for the summary of a Strata update and for each
# task of the code benchmark, at least 10. Empty: a suggestion from the
# speed of the slowest installed model.
#UPDATE_SUMMARY_TIMEOUT_SECS=
#CODE_BENCH_TASK_TIMEOUT_SECS=

# Idle timeout before sleep in seconds (15 min)
IDLE_TIMEOUT_SECS=900

# Longest wait during wake-up in seconds (including a Strata restart)
WAKE_TIMEOUT_SECS=240

# Strata's API key (the same as in Strata), for the proxy's own calls
# to Strata, e.g. the metrics for the Overview
#STRATA_API_KEY=
# Time zone for times of day on the Overview and keep awake "Until 8:00"
TZ=Europe/Berlin
# Initial password of the web UI under /admin/ (otherwise "admin"). At the first
# login a password of your own must be set.
#UI_PASSWORD=
