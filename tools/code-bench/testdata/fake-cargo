#!/usr/bin/env python3
"""Stands in for cargo in the runner's tests, for the repo task the tests
make: "builds" unless src/lib.txt says "broken", and its tests pass by what
src/lib.txt names. The hidden test file must be the runner's."""
import os, sys, time

lib = open("src/lib.txt").read() if os.path.exists("src/lib.txt") else ""
with open("fake-cargo-args.txt", "w") as f:
    f.write(" ".join(sys.argv[1:]) + f"\nuid={os.getuid()}\ncargo_home={os.environ.get('CARGO_HOME')}\n")
if "hang" in lib:
    time.sleep(600)
if "broken" in lib:
    print("   Compiling adder v0.1.0", file=sys.stderr)
    print("error[E0425]: cannot find value `x` in this scope", file=sys.stderr)
    print("error: could not compile `adder` (lib) due to 1 previous error", file=sys.stderr)
    sys.exit(101)
hidden = open("tests/adder.rs").read() if os.path.exists("tests/adder.rs") else ""
real = hidden == "// the feature's tests\n"
print("     Running unittests src/lib.rs (target/debug/deps/adder-0123456789abcdef)")
print("test old ... " + ("FAILED" if "break-old" in lib else "ok"))
print("test other_old ... ok")
print("     Running tests/adder.rs (target/debug/deps/adder_tests-fedcba9876543210)")
for name in ("adds", "subtracts"):
    print(f"test {name} ... " + ("ok" if real and name in lib else "FAILED"))
print("   Doc-tests adder")
print("test src/lib.rs - add (line 3) ... ok")
